# Copie para .env e preencha. O .env NUNCA e versionado (ver .gitignore).
#
# Gere os segredos com valores aleatorios reais, nunca com palavras escolhidas
# a mao. Sugestao:
#   openssl rand -base64 48

# --- Banco de dados ---------------------------------------------------------
KODA_DB_NAME=koda
KODA_DB_USER=koda
KODA_DB_PASSWORD=troque-por-uma-senha-aleatoria
KODA_DB_URL=jdbc:postgresql://localhost:5432/koda

# --- Redis ------------------------------------------------------------------
KODA_REDIS_HOST=localhost
KODA_REDIS_PORT=6379

# --- Seguranca --------------------------------------------------------------
# Minimo de 32 bytes; a aplicacao se recusa a subir com menos.
# Trocar este valor invalida todos os access tokens em circulacao.
KODA_JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-bytes

# --- Aplicacao --------------------------------------------------------------
KODA_PORT=8080
KODA_CORS_ORIGINS=http://localhost:3000
